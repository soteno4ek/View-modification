CREATE OR REPLACE VIEW v_teacher_subjects AS
SELECT 
    t.name AS teacher_name, s.name AS subject_name, ts.is_main
FROM TeacherSubjects ts
JOIN Teachers t ON t.teacher_id = ts.teacher_id
JOIN Subjects s ON s.subject_id = ts.subject_id;

CREATE OR REPLACE FUNCTION tf_v_ts_insert()
RETURNS TRIGGER AS $$
DECLARE
    v_teacher_id integer;
    v_subject_id integer;
BEGIN
    SELECT teacher_id INTO v_teacher_id FROM Teachers WHERE name = NEW.teacher_name;
    IF NOT FOUND THEN
        SELECT COALESCE(MAX(teacher_id), 0) + 1 INTO v_teacher_id FROM Teachers;
        INSERT INTO Teachers (teacher_id, name) VALUES (v_teacher_id, NEW.teacher_name);
    END IF;

    SELECT subject_id INTO v_subject_id FROM Subjects WHERE name = NEW.subject_name;
    IF NOT FOUND THEN
        SELECT COALESCE(MAX(subject_id), 0) + 1 INTO v_subject_id FROM Subjects;
        INSERT INTO Subjects (subject_id, name) VALUES (v_subject_id, NEW.subject_name);
    END IF;

    INSERT INTO TeacherSubjects (teacher_id, subject_id, is_main)
    VALUES (v_teacher_id, v_subject_id, COALESCE(NEW.is_main, false))
    ON CONFLICT (teacher_id, subject_id) DO UPDATE
    SET is_main = EXCLUDED.is_main;

    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_v_ts_insert
INSTEAD OF INSERT ON v_teacher_subjects
FOR EACH ROW EXECUTE FUNCTION tf_v_ts_insert();

CREATE OR REPLACE FUNCTION tf_v_ts_update()
RETURNS TRIGGER AS $$
DECLARE
    v_new_teacher_id integer;
    v_new_subject_id integer;
BEGIN
    SELECT teacher_id INTO v_new_teacher_id FROM Teachers WHERE name = NEW.teacher_name;
    IF NOT FOUND THEN
        SELECT COALESCE(MAX(teacher_id), 0) + 1 INTO v_new_teacher_id FROM Teachers;
        INSERT INTO Teachers (teacher_id, name) VALUES (v_new_teacher_id, NEW.teacher_name);
    END IF;

    SELECT subject_id INTO v_new_subject_id FROM Subjects WHERE name = NEW.subject_name;
    IF NOT FOUND THEN
        SELECT COALESCE(MAX(subject_id), 0) + 1 INTO v_new_subject_id FROM Subjects;
        INSERT INTO Subjects (subject_id, name) VALUES (v_new_subject_id, NEW.subject_name);
    END IF;

    UPDATE TeacherSubjects ts
    SET teacher_id = v_new_teacher_id,
        subject_id = v_new_subject_id,
        is_main = NEW.is_main
    FROM Teachers t, Subjects s
    WHERE ts.teacher_id = t.teacher_id AND t.name = OLD.teacher_name
      AND ts.subject_id = s.subject_id AND s.name = OLD.subject_name;

    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_v_ts_update
INSTEAD OF UPDATE ON v_teacher_subjects
FOR EACH ROW EXECUTE FUNCTION tf_v_ts_update();

CREATE OR REPLACE FUNCTION tf_v_ts_delete()
RETURNS TRIGGER AS $$
BEGIN
    DELETE FROM TeacherSubjects ts
    USING Teachers t, Subjects s
    WHERE ts.teacher_id = t.teacher_id AND t.name = OLD.teacher_name
      AND ts.subject_id = s.subject_id AND s.name = OLD.subject_name;

    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_v_ts_delete
INSTEAD OF DELETE ON v_teacher_subjects
FOR EACH ROW EXECUTE FUNCTION tf_v_ts_delete();

